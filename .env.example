APP_NAME="Wear&Earn"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.de

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_TIMEZONE=Europe/Berlin

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wear_and_earn
DB_USERNAME=wear_and_earn
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.de
MAIL_FROM_NAME="${APP_NAME}"
